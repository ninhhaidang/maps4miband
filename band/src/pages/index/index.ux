<template>
  <stack class="page">
    <div class="map">
      <div for="{{segs}}" class="seg"
           style="left: {{$item.l}}px; top: {{$item.t}}px; width: {{$item.w}}px; transform: {{$item.r}};"></div>
      <!-- the phone puts the rider at (106, 280), heading up -->
      <div class="me"></div>
    </div>
    <div class="panel">
      <div class="row">
        <image show="{{hasArrow}}" class="arrow" src="/common/arrow.png" style="transform: {{arrowTransform}};"></image>
        <text class="dist">{{dist}}</text>
      </div>
      <text class="instr">{{instr}}</text>
      <text class="rem">{{rem}}</text>
    </div>
  </stack>
</template>

<style>
.page {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.map {
  width: 212px;
  height: 360px;
}
.seg {
  position: absolute;
  height: 8px;
  border-radius: 4px;
  background-color: #2f8cff;
  transform-origin: 50% 50%;
}
.me {
  position: absolute;
  left: 97px;
  top: 271px;
  width: 18px;
  height: 18px;
  border-radius: 9px;
  border-width: 3px;
  border-color: #ffffff;
  background-color: #ff7a00;
}
.panel {
  position: absolute;
  top: 360px;
  width: 212px;
  height: 160px;
  padding: 8px 10px;
  flex-direction: column;
  background-color: #111111;
}
.row {
  flex-direction: row;
  align-items: center;
}
.arrow {
  width: 48px;
  height: 48px;
  margin-right: 8px;
}
.dist {
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}
.instr {
  margin-top: 4px;
  font-size: 18px;
  color: #ffffff;
  lines: 2;
  text-overflow: ellipsis;
}
.rem {
  margin-top: 4px;
  font-size: 14px;
  color: #8a8a8a;
}
</style>

<script>
import interconnect from '@system.interconnect'
import brightness from '@system.brightness'
import vibrator from '@system.vibrator'
import { segments, rotate } from '../../common/render.js'

export default {
  private: {
    segs: [],
    hasArrow: false,
    arrowTransform: rotate(0),
    dist: '',
    instr: 'Bắt đầu dẫn đường trên điện thoại',
    rem: ''
  },
  onInit() {
    brightness.setKeepScreenOn({ keepScreenOn: true })
    this.conn = interconnect.instance()
    this.conn.onmessage = (msg) => {
      let m
      try {
        m = JSON.parse(msg.data)
      } catch (e) {
        console.log('bad message: ' + msg.data)
        return
      }
      this.show(m)
    }
  },
  onDestroy() {
    brightness.setKeepScreenOn({ keepScreenOn: false })
  },
  // Message from the phone: p = flat polyline in screen px, a = turn angle (deg, null = no arrow),
  // d = distance to the turn, i = instruction, r = remaining trip, v = 1 to buzz.
  show(m) {
    this.segs = segments(m.p || [])
    this.hasArrow = m.a !== null && m.a !== undefined
    this.arrowTransform = rotate(m.a || 0)
    this.dist = m.d || ''
    this.instr = m.i || ''
    this.rem = m.r || ''
    if (m.v) vibrator.vibrate({ mode: 'long' })
  }
}
</script>
