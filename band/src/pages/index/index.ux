<template>
  <!-- Later children draw on top: the map fills the page, the panel covers its top MAP_TOP px. -->
  <stack class="page">
    <div class="map">
      <div for="{{segs}}" class="seg"
           style="left: {{$item.l}}px; top: {{$item.t}}px; width: {{$item.w}}px; transform: {{$item.r}};"></div>
      <div for="{{marks}}" class="mark" style="left: {{$item.l}}px; top: {{$item.t}}px;"></div>
      <text show="{{hasLabel}}" class="label" style="left: {{labelL}}px; top: {{labelT}}px; width: {{labelW}}px; height: {{labelH}}px;">{{street}}</text>
      <!-- the phone puts the rider at (106, 460), heading up (Tuning.meX/meY) -->
      <div class="me"></div>
    </div>
    <!-- Layout A, picked on the band (docs/band-screen.md): arrow and distance on one row, two-line instruction,
         remaining trip. -->
    <div class="panel">
      <div class="row">
        <image show="{{hasArrow}}" class="arrow" src="/common/arrow.png" style="transform: {{arrowTransform}};"></image>
        <text class="dist">{{dist}}</text>
      </div>
      <text class="instr">{{instr}}</text>
      <text class="rem">{{rem}}</text>
    </div>
  </stack>
</template>

<style>
/* Text stays centred; near the top and bottom ends a row only keeps 212 - 2 × inset(y) px (render.js). */
.page {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.map {
  width: 212px;
  height: 520px;
}
.seg {
  position: absolute;
  height: 8px;
  border-radius: 4px;
  background-color: #2f8cff;
  /* px only: the band reads 50% as 50px */
  transform-origin: 4px 4px;
}
.mark {
  position: absolute;
  width: 16px;
  height: 16px;
  border-radius: 8px;
  border-width: 3px;
  border-color: #ffffff;
  background-color: #2f8cff;
}
.label {
  position: absolute;
  /* width and height from label() in render.js, PAD of padding */
  padding: 0 4px;
  border-radius: 6px;
  background-color: #222222;
  font-size: 14px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  lines: 2;
  text-overflow: ellipsis;
}
.me {
  position: absolute;
  left: 97px;
  top: 451px;
  width: 18px;
  height: 18px;
  border-radius: 9px;
  border-width: 3px;
  border-color: #ffffff;
  background-color: #ff7a00;
}
.panel {
  position: absolute;
  top: 0px;
  width: 212px;
  /* MAP_TOP in render.js */
  height: 170px;
  /* The arrow + distance row is up to ~172 px wide ("10.5 km"); from y 40 down the corners cut at most 20 px a side. */
  padding: 40px 12px 0 12px;
  flex-direction: column;
  align-items: center;
  background-color: #111111;
}
.row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.arrow {
  width: 52px;
  height: 52px;
  margin-right: 8px;
  transform-origin: 26px 26px;
}
.dist {
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
}
.instr {
  width: 188px;
  margin-top: 4px;
  font-size: 19px;
  color: #ffffff;
  text-align: center;
  lines: 2;
  text-overflow: ellipsis;
}
.rem {
  margin-top: 2px;
  font-size: 15px;
  color: #8a8a8a;
}
</style>

<script>
import interconnect from '@system.interconnect'
import brightness from '@system.brightness'
import vibrator from '@system.vibrator'
import { segments, rotate, label } from '../../common/render.js'

export default {
  private: {
    segs: [],
    marks: [],
    hasLabel: false,
    labelL: 0,
    labelT: 0,
    labelW: 0,
    labelH: 0,
    street: '',
    hasArrow: false,
    arrowTransform: rotate(0),
    dist: '',
    instr: 'Bắt đầu dẫn đường trên điện thoại',
    rem: ''
  },
  onInit() {
    brightness.setKeepScreenOn({ keepScreenOn: true })
    this.conn = interconnect.instance()
    this.conn.onmessage = (msg) => {
      let m
      try {
        m = JSON.parse(msg.data)
      } catch (e) {
        console.log('bad message: ' + msg.data)
        // Also what a message over the band's 16 KB limit turns into (docs/band-screen.md).
        this.show({ i: 'Tin nhắn hỏng (' + msg.data.length + ' ký tự)' })
        return
      }
      this.show(m)
    }
  },
  onDestroy() {
    brightness.setKeepScreenOn({ keepScreenOn: false })
  },
  // Message from the phone (BandMessage in ios/Navigator): p = flat polyline in screen px, t = turn marks on it
  // (flat x,y), n = street at the first mark, a = turn angle (deg, null = no arrow), d = distance to the turn,
  // i = instruction, r = remaining trip, v = 1 to buzz.
  show(m) {
    const p = m.p || []
    this.segs = segments(p)
    const t = m.t || []
    const marks = []
    for (let k = 0; k + 1 < t.length; k += 2) marks.push({ l: t[k] - 8, t: t[k + 1] - 8 }) // centre of the 16 px .mark
    this.marks = marks
    const box = t.length >= 2 && m.n ? label(t[0], t[1], m.n, p) : null
    this.hasLabel = box !== null
    if (box) {
      this.labelL = box.l
      this.labelT = box.t
      this.labelW = box.w
      this.labelH = box.h
      this.street = m.n
    }
    this.hasArrow = m.a !== null && m.a !== undefined
    this.arrowTransform = rotate(m.a || 0)
    this.dist = m.d || ''
    this.instr = m.i || ''
    this.rem = m.r || ''
    if (m.v) vibrator.vibrate({ mode: 'long' })
  }
}
</script>
