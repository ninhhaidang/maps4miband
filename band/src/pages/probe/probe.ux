<template>
  <!-- shortcut: measuring page for #15 (long-press the navigation screen to open, tap for the next count, swipe back);
       delete it and its router entry once docs/band-screen.md has the numbers. -->
  <stack class="page" onclick="next">
    <!-- N grey streets drawn once, then only the layer moves each second, as a ride would move it. -->
    <div class="layer" style="left: {{lx}}px; top: {{ly}}px;">
      <div for="{{layer}}" class="street"
           style="left: {{$item.l}}px; top: {{$item.t}}px; width: {{$item.w}}px; transform: {{$item.r}};"></div>
    </div>
    <!-- About what a real frame redraws on top: the route, new every second. -->
    <div for="{{route}}" class="seg"
         style="left: {{$item.l}}px; top: {{$item.t}}px; width: {{$item.w}}px; transform: {{$item.r}};"></div>
    <div class="legend">
      <text class="key">{{count}} đường xám</text>
      <text class="key">dựng lớp {{build}} ms</text>
      <text class="key">chậm nhất {{worst}} ms</text>
      <text class="key">{{minutes}} phút</text>
    </div>
  </stack>
</template>

<style>
.page {
  width: 212px;
  height: 520px;
  background-color: #000000;
}
.layer {
  position: absolute;
  width: 332px;
  height: 470px;
}
.street {
  position: absolute;
  height: 4px;
  border-radius: 2px;
  background-color: #4a4a4a;
  transform-origin: 2px 2px;
}
.seg {
  position: absolute;
  height: 8px;
  border-radius: 4px;
  background-color: #2f8cff;
  transform-origin: 4px 4px;
}
.legend {
  position: absolute;
  left: 26px;
  top: 40px;
  width: 160px;
  flex-direction: column;
  align-items: center;
  background-color: #111111;
}
.key {
  font-size: 16px;
  color: #ffffff;
  text-align: center;
}
</style>

<script>
import { segments, streets } from '../../common/render.js'

const COUNTS = [100, 300, 500, 800]

export default {
  private: {
    count: 0,
    layer: [],
    route: [],
    lx: -60,
    ly: 50,
    build: 0,
    worst: 0,
    minutes: 0
  },
  onInit() {
    this.next()
  },
  onDestroy() {
    clearInterval(this.timer)
  },
  next() {
    clearInterval(this.timer)
    this.count = COUNTS[(COUNTS.indexOf(this.count) + 1) % COUNTS.length]
    this.layer = []
    this.build = 0
    this.worst = 0
    // Street pieces 10–40 px long at any angle, anywhere on the 332×470 layer.
    const g = []
    for (let k = 0; k < this.count; k++) {
      const x = Math.random() * 332
      const y = Math.random() * 470
      const a = Math.random() * Math.PI
      const len = 10 + Math.random() * 30
      g.push(Math.round(x), Math.round(y), Math.round(x + len * Math.cos(a)), Math.round(y + len * Math.sin(a)))
    }
    const start = Date.now()
    this.layer = streets(g)
    let last = start
    let first = true
    // A slow render holds up the JS thread and shows as a late tick: the first is building the layer.
    this.timer = setInterval(() => {
      const now = Date.now()
      if (first) {
        this.build = now - start - 1000
        first = false
      } else {
        this.worst = Math.max(this.worst, now - last)
      }
      last = now
      const t = (now - start) / 1000
      this.minutes = Math.floor(t / 60)
      this.lx = Math.round(-60 + 40 * Math.sin(t / 10))
      this.ly = Math.round(50 + 40 * Math.cos(t / 10))
      const p = []
      let x = 106
      let y = 520
      for (let k = 0; k <= 20; k++) {
        p.push(Math.round(x), Math.round(y))
        x = Math.min(Math.max(x + Math.random() * 30 - 15, 10), 202)
        y -= 17
      }
      this.route = segments(p)
    }, 1000)
  }
}
</script>
